# Default to LF line endings, auto-detect text vs binary
* text=auto eol=lf

# Force LF on shell scripts, plists, YAML, source
*.sh    text eol=lf
*.swift text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.plist text eol=lf
*.entitlements text eol=lf
*.xcstrings    text eol=lf
Makefile       text eol=lf

# Binary
*.png   binary
*.jpg   binary
*.icns  binary
*.dmg   binary
*.zip   binary
*.p12   binary
