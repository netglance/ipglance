# ──────────── macOS ────────────
.DS_Store
._*
.AppleDouble
.LSOverride
Icon?

# ──────────── Xcode build output ────────────
build/
DerivedData/
*.xcuserstate
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# ──────────── Xcode project (regenerated by xcodegen from project.yml) ────────────
*.xcodeproj/
*.xcworkspace/
# But DO track Package.resolved so SPM deps lock — see the comment below in the SPM block
!IPGlanceApp.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
xcuserdata/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# ──────────── Swift Package Manager ────────────
.build/
.swiftpm/
# Note: Package.resolved is intentionally tracked when it exists (locks deps for reproducible builds).

# ──────────── IDEs ────────────
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace

# ──────────── Tooling state / AI artifacts ────────────
.ai/
.superpowers/
.claude/
CLAUDE.md
AGENTS.md
.aider*

# ──────────── Release artifacts ────────────
# DMGs are produced by `make dmg` and uploaded to GitHub Releases — don't commit binaries.
*.dmg
*.zip
rw.*.dmg

# ──────────── Secrets / signing material ────────────
# Never commit certificates, keys, provisioning profiles, or env files.
*.crt
*.cer
*.pem
*.p12
*.key
*.mobileprovision
.env
.env.*
!.env.example
notarytool-creds.json

# ──────────── Coverage / profiling ────────────
*.gcno
*.gcda
*.profraw
*.profdata
coverage/

# ──────────── Logs ────────────
*.log
