    "killswitch_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block internet outside allowed countries"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировать интернет вне разрешённых стран"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokuj internet poza dozwolonymi krajami"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокувати інтернет поза дозволеними країнами"
          }
        }
      }
    },
    "killswitch_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The country is checked every 8–20 s, so some traffic may get through before the block. After a reboot, protection stays off until IPGlance starts. You'll be asked for your admin password once."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страна проверяется каждые 8–20 с, поэтому до блокировки часть трафика может уйти. После перезагрузки защита не работает, пока не запустится IPGlance. Пароль администратора понадобится один раз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraj jest sprawdzany co 8–20 s, więc przed blokadą część ruchu może wyciec. Po ponownym uruchomieniu komputera ochrona nie działa, dopóki nie uruchomi się IPGlance. Hasło administratora będzie potrzebne tylko raz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Країна перевіряється кожні 8–20 с, тому до блокування частина трафіку може піти. Після перезавантаження захист не працює, доки не запуститься IPGlance. Пароль адміністратора знадобиться один раз."
          }
        }
      }
    },
    "killswitch_allowed": {
      "localizations": {
