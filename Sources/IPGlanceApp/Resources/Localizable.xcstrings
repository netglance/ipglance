    "about": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О программе"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O programie"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Про програму"
          }
        }
      }
    },
    "about_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows your public IP address, country, city and ISP directly from the macOS menu bar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает ваш публичный IP-адрес, страну, город и провайдера прямо из строки меню macOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla publiczny adres IP, kraj, miasto i dostawcę internetu bezpośrednio na pasku menu macOS."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує ваш публічний IP-адрес, країну, місто та провайдера прямо з рядка меню macOS."
          }
        }
      }
    },
    "autostart_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IPGlance will run in the background from macOS startup"
